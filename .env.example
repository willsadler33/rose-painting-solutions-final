# ─────────────────────────────────────────────────────────────
# Settings for the Rose Painting Solutions website.
# Copy to .env for local use. On Netlify, add these under
# Site configuration → Environment variables. NEVER commit real values.
# Use DIFFERENT values for Production and for Deploy Previews.
# ─────────────────────────────────────────────────────────────

# Where the contact form sends enquiries (Formspree or similar, https only).
# This value is public (it ships in the browser bundle) — never put API
# secrets or passwords in a VITE_ variable.
VITE_FORM_ENDPOINT=

# ── Owner dashboard (/admin) — private, server-side only ──
# A long random secret that signs sign-in cookies. 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Temporary password for the owner's FIRST sign-in (12+ characters).
# The dashboard makes them choose their own password straight away; after
# that this value no longer works. Give it to the owner privately.
ADMIN_INITIAL_PASSWORD=

# Emergency reset: set to "yes" (with ADMIN_INITIAL_PASSWORD) to let the
# initial password work again if the owner forgets theirs. Remove it again
# as soon as they've chosen a new password.
ADMIN_PASSWORD_RESET=

# Leave unset. The live website's data is only ever used by the production
# deploy; Deploy Previews automatically use a separate test copy.
# "preview" forces every deploy (including production) onto the test copy.
RPS_DATA_ENV=
